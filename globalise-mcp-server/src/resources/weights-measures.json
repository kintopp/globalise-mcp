    "source_url": "https://hdl.handle.net/10622/MDNVH5",
    "license": "CC-BY-SA-4.0",
    "citation": "Vellinga, Henrike; Nijman, Brecht; Kuruppath, Manjusha, 2024, 'GLOBALISE - Weights and Measures in the 18th Century Indian Ocean World', IISH Data Collection, V1",
    "units_count": 213,
    "variants_count": 385
  },
  "units": {
    "SU_0003": {
      "label": "Mutsje",
      "type": "volume",
      "definition": "Measure of volume 1⁄8 mingelen, about 150 centiliters."
    },
    "SU_0007": {
      "label": "Bahar",
      "type": "weight",
      "definition": "From Sanskrit, bahara, weight; a measure of weight widely used in Southeast Asia, 1 bahar = 3 pikul, or 170 kilograms, or 375 Dutch pounds; varying from place to place, but approximately 180 kilograms for pepper and 272 kilograms for cloves, but 7.25 kilograms when weighing gold. In the Moluccos Portuguese bahar was used with the equivalent of 550 Amsterdam pounds, a Javanese bahar was 220 pounds."
    },
    "SU_0011": {
      "label": "Pond (VOC)",
      "type": "weight",
      "definition": "Measure of weight. The Amsterdam or Trooise (from Troyes) pound was 0.494 kilogrammes, the Delft, Antwerp or Brabantine pound were 0.4697 kilogrammes, the Cologne pount 0.4677 kilogram. The Amsterdam pound served as a standard weight."
    },
    "SU_0012": {
      "label": "Pond (Engels)",
      "type": "weight",
      "definition": "Measure of weight. 9/20 of a kilogram"
    },
