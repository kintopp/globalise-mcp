{
  "name": "globalise-mcp-server",
  "version": "2.0.1",
  "description": "MCP server for GLOBALISE Transcriptions Viewer - search Dutch East India Company (VOC) historical transcriptions",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run build:ui && tsc && npm run build:db",
    "build:ui": "vite build -c apps/document-viewer/vite.config.ts",
    "build:db": "npx tsx scripts/build-archival-db.ts",
    "dev": "tsc --watch",
    "dev:ui": "vite build -c apps/document-viewer/vite.config.ts --watch",
    "start": "node dist/index.js",
    "inspector": "npm run build && npx @modelcontextprotocol/inspector dist/index.js",
    "test:smoke": "npx tsx scripts/smoke-test.ts"
  },
  "keywords": [
    "mcp",
    "globalise",
    "voc",
    "transcriptions",
    "historical-documents"
  ],
  "author": "Arno Bosse with Claude Code",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "express": "^5.1.0",
    "n3": "^1.26.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.0.0"
  }
}
