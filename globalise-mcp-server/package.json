{
  "name": "globalise-mcp-server",
  "version": "2.10.1",
  "description": "MCP server for GLOBALISE Transcriptions Viewer - search Dutch East India Company (VOC) historical transcriptions",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "glob-mcp": "scripts/cli.mjs"
  },
  "scripts": {
    "build": "npm run build:ui && tsc && npm run ensure:db",
    "build:ui": "vite build -c apps/document-viewer/vite.config.ts",
    "build:db": "npx tsx scripts/build-archival-db.ts",
    "build:db:commodities": "npx tsx scripts/build-commodities-db.ts",
    "ensure:db": "npx tsx scripts/ensure-archival-db.ts && npx tsx scripts/ensure-reference-db.ts",
    "build:mcpb": "npm run build && npx tsx scripts/build-mcpb.ts",
    "build:mcpb:thin": "npm run build && npx tsx scripts/build-mcpb.ts thin",
    "validate:mcpb": "npx -y @anthropic-ai/mcpb validate manifest.json",
    "validate:mcpb:thin": "npx -y @anthropic-ai/mcpb validate manifest.thin.json",
    "test:mcpb": "npx tsx scripts/test-mcpb-bundle.ts",
    "dev": "tsc --watch",
    "dev:ui": "vite build -c apps/document-viewer/vite.config.ts --watch",
    "start": "node dist/index.js",
    "cli": "node scripts/cli.mjs",
    "test:cli": "npx tsx scripts/test-cli.ts",
    "inspector": "npm run build && npx @modelcontextprotocol/inspector dist/index.js",
    "test": "npm run test:version && npm run test:fts && npm run test:archival && npm run test:commodities && npm run test:measures && npm run test:viewer-typecheck && npm run test:viewer-build && npm run test:viewer-protocol && npm run test:smoke && npm run test:http-shutdown",
    "test:version": "npx tsx scripts/check-version-sync.ts",
    "test:live": "npx tsx scripts/test-live-api.ts",
    "test:http-shutdown": "npx tsx scripts/test-http-shutdown.ts",
    "test:smoke": "npx tsx scripts/smoke-test.ts",
    "test:fts": "npx tsx scripts/test-fts.ts",
    "test:archival": "npx tsx scripts/test-archival-index.ts",
    "test:commodities": "npx tsx scripts/test-commodities.ts",
    "test:measures": "npx tsx scripts/test-measures.ts",
    "test:viewer-typecheck": "tsc -p apps/document-viewer",
    "test:viewer-build": "npx tsx scripts/test-viewer-build.ts",
    "test:viewer-protocol": "npx tsx scripts/test-viewer-protocol.ts"
  },
  "keywords": [
    "mcp",
    "globalise",
    "voc",
    "transcriptions",
    "historical-documents"
  ],
  "author": "Arno Bosse with Claude Code",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0 <25.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cors": "^2.8.6",
    "express": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "csv-parse": "^7.0.0",
    "n3": "^2.0.3",
    "openseadragon": "^6.0.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
