{
  // Standalone (NOT extending ../tsconfig.json) by design: the root tsconfig
  // compiles src/ to dist/ and excludes JS; this config type-checks ONLY the
  // plain-JS CLI (scripts/cli.mjs) via allowJs + checkJs, with noEmit. It is
  // deliberately NOT strict — strict mode reports ~76 implicit-any errors on
  // untyped JS; lenient checkJs still catches the real bug class (undefined
  // access, wrong arity, bad property types) and stays in the offline npm test
  // chain. Mirrors apps/document-viewer/tsconfig.json (the viewer's gate).
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["cli.mjs"]
}
