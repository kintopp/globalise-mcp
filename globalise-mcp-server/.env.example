# GLOBALISE MCP server — environment variables (all optional; defaults shown).
# Copy to .env only if your tooling loads one — the server itself reads plain
# process.env (Railway service variables in prod, shell env locally).

# ── Transport ────────────────────────────────────────────────────────────────
# 'stdio' (default; Claude Desktop) or 'http' (Railway / remote clients).
#TRANSPORT=stdio
# HTTP transport port.
#PORT=3000
# HTTP CORS allowlist (comma-separated). Default: * (all origins).
#ALLOWED_ORIGINS=*
# Origin-header validation allowlist for MCP requests (spec MUST). Defaults to
# the known MCP hosts (src/utils/origin.ts); '*' disables validation.
#MCP_ALLOWED_ORIGINS=

# ── Response shaping ─────────────────────────────────────────────────────────
# Set to 'false' for clients that reject outputSchema/structuredContent
# (e.g. MSTY, Jan.ai).
#STRUCTURED_CONTENT=true
# Set to 'false' to stop counting the text channel as a metered duplicate of
# structuredContent when dividing the per-result budget.
#RESPONSE_TEXT_DUPLICATES_DATA=true
# Host per-result character ceiling the safe budget (80%) is derived from.
#RESULT_CHAR_CEILING=150000

# ── Local databases ──────────────────────────────────────────────────────────
# Archival finding-aid index (~112 MB). Default: data/archival-index.sqlite.
#ARCHIVAL_DB_PATH=
# Where the thin bundle downloads the index (.gz) on first use; unset = no
# download, the tool reports the index as unavailable instead.
#ARCHIVAL_DB_URL=
# Optional bearer token for that download.
#ARCHIVAL_DB_TOKEN=
# Idle timeout for the download (ms) — aborts when no bytes arrive for this long.
#ARCHIVAL_DB_TIMEOUT_MS=30000
# Commodities + measures glossaries. Default: data/reference.sqlite.
#REFERENCE_DB_PATH=

# ── Diagnostics / CLI ────────────────────────────────────────────────────────
# 'true' adds a response-length debug line per tool call on stderr (the
# per-call {tool, ms, ok, ...} JSON log line is always on).
#DEBUG=false
# Default --http endpoint for the headless CLI (scripts/cli.mjs).
#GLOBALISE_MCP_HTTP=
