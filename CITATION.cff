cff-version: 1.2.0
message: "If you use this software in your research, please cite it as below."
type: software
title: "GLOBALISE MCP Server"
abstract: >
  An MCP server providing AI-mediated access to the GLOBALISE corpus of
  machine-generated (HTR) transcriptions of Dutch East India Company (VOC)
  records, supporting full-text search, document retrieval and sequential
  navigation, archival finding-aid search, an interactive scan-and-transcription
  viewer, and glossaries of VOC commodities and weights & measures.
authors:
  - family-names: Bosse
    given-names: Arno
    orcid: "https://orcid.org/0000-0003-3681-1289"
    affiliation: "Research and Infrastructure Support (RISE), University of Basel"
repository-code: "https://github.com/kintopp/globalise-mcp"
url: "https://globalise-mcp-production.up.railway.app/mcp"
license: MIT
version: "2.11.10"
date-released: "2026-08-03"
keywords:
  - digital humanities
  - colonial archives
  - Dutch East India Company
  - VOC
  - model context protocol
  - GLOBALISE
  - historical transcriptions
references:
  - type: software
    title: "Claude Code"
    authors:
      - name: "Anthropic"
    url: "https://www.anthropic.com"
    notes: "AI coding assistant used in the development of this software"
  - type: dataset
    title: "GLOBALISE VOC Transcriptions"
    authors:
      - name: "GLOBALISE Project, Huygens Institute (KNAW)"
    url: "https://globalise.huygens.knaw.nl/"
    license: CC0-1.0
    notes: >
      Machine-generated (HTR) transcriptions of ~4.8M pages of VOC records,
      accessed via the GLOBALISE Transcriptions API. Cite as: NL-HaNA, VOC,
      [inv.nr.], [scan nr.], transcription GLOBALISE project
      (https://globalise.huygens.knaw.nl/), March 2024.
