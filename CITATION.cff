        given-names: M.
    version: "1"
    year: 2023
    publisher:
      name: "IISH Data Collection"
    url: "https://hdl.handle.net/10622/YAWDOV"
    license: CC-BY-SA-4.0
    notes: >
      Basis of the commodities glossary in reference.sqlite. SUBSTANTIALLY
      MODIFIED: definitions and English labels added (over half AI-generated and
